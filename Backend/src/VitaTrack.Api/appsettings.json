{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=vitatrack_develop;Username=postgres;Password=postgres;"
  },
  "JwtSettings": {
    "Key": "development-only-change-me",
    "Issuer": "VitaTrack",
    "Audience": "VitaTrack.Api",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:5174",
    "http://localhost:4173"
  ],
  "Database": {
    "MigrateOnStartup": true
  },
  "Hangfire": {
    "Connection": ""
  }
}